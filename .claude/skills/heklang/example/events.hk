// Every fact this application records. An event is written whole and never changes,
// so a field with a hole in it would be a different fact.

// A key namespace, declared. Its values are attendee ids, and a field of this type is
// what `@subject(...)` files a key under: the field could be called `who` and it would
// still be the same namespace, because the type carries the identity and the name does
// not.
subject Attendee(Int)

event @workshop.opened {
  workshop_id: Uuid,
  title: String @max(120),
  seats: Int,
  price: Money(2),
}

event @seat.booked {
  workshop_id: Uuid,
  booking_id: Uuid,
  attendee_id: Attendee,
  // `@subject(attendee_id)` makes this Sealed(String, Attendee): a projector may store
  // it, only an effect may `reveal` it, and `erase(e.attendee_id)` makes every seal
  // filed under that id permanently unreadable. The seal carries the *subject*, which is
  // what a key store files under; the annotation names the sibling field holding the id.
  email: String @subject(attendee_id) @max(200),
  paid: Money(2),
}

event @seat.released {
  workshop_id: Uuid,
  booking_id: Uuid,
  attendee_id: Attendee,
}

event @booking.confirmed {
  booking_id: Uuid,
  notification_id: Uuid,
  at: Timestamp,
  // Added once confirmations were already in the log, which is the one thing an
  // append-only log cannot go back and fill in. `@absent` says what those events read
  // as, so the field stays required for every new one and no handler has to deal with an
  // optional it would only ever see absent on history. Make it `String?` instead when
  // absence is part of the domain rather than an artefact of when the field arrived.
  channel: String @max(20) @absent("email"),
}
