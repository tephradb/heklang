// The other read side, and the one to reach for first. A named fold says what one value
// is, which events change it and what it is keyed by, and the table follows: these five
// folds are two tables, because `workshop` and `(workshop, attendee)` are two key
// signatures. Run `hek check --tables` over this directory to see them.
//
// Nothing here declares a table, a column or an index. Compare `projector.hk`, which
// declares an entity and then copies fields onto it: the same values, with the schema
// written by hand and a handler to keep in step with it.

// The column is `workshop_seats_left`, which is this name in snake_case. Named for the
// value and not for the entity, so it is not `Workshop`: one value out, and a command
// reading it conflicts on exactly these two slices.
fold WorkshopSeatsLeft(workshop_id: Uuid) -> left: Int = 0 {
  on @workshop.opened(workshop_id) { seats } => seats
  on @seat.booked(workshop_id) => left - 1
  on @seat.released(workshop_id) => left + 1
}

fold WorkshopRevenue(workshop_id: Uuid) -> taken: Money(2) = 0 {
  on @seat.booked(workshop_id) { paid } => taken + paid
  on @seat.released(workshop_id) => taken
}

// A second key signature, so a second table, and `--tables` calls it
// `attendee__workshop` rather than `workshop__attendee`: a part is named for its
// **subject** when its type has one, and subject parts lead. Guessing a derived name is
// how you get it wrong; `hek check --tables` is how you read it.
fold AttendeeSeats(workshop_id: Uuid, attendee_id: Attendee) -> held: Int = 0 {
  on @seat.booked(workshop_id, attendee_id) => held + 1
  on @seat.released(workshop_id, attendee_id) => held - 1
}

// A sealed return type, which is spellable here and nowhere else. The column holds
// content the application can never read: an effect `reveal`s it, and erasing the
// attendee's key makes it read back absent without anything touching the stored row.
fold AttendeeEmail(
  workshop_id: Uuid,
  attendee_id: Attendee,
) -> Sealed(String, Attendee)? = none {
  on @seat.booked(workshop_id, attendee_id) { email } => email
}

// Query-only, because the arm binds the envelope with `as`. It is stored and a test may
// read it; a command may not, since an append time is not a decision's to read. The
// event's own `channel` field is domain data and needs none of this.
fold AttendeeBookedAt(workshop_id: Uuid, attendee_id: Attendee) -> Timestamp? = none {
  on @seat.booked as e (workshop_id, attendee_id) => e.at
}

// A key part the arm computes, which is how a read model buckets by time: no event
// carries a month, and `key` is evaluated per record where a filter resolves once for
// the whole slice. Like the envelope binding above it, computing a part makes the fold
// query-only, and for the same reason: there is no predicate form for a command to read
// it with.
fn month_of(at: Timestamp) -> String {
  return "{at.year()}-{at.month().pad(2)}"
}

fold MonthlyRevenue(workshop_id: Uuid, month: String) -> taken: Money(2) = 0 {
  on @seat.booked as e (workshop_id) { paid } key month = month_of(e.at) => taken + paid
}

// Rule 15: a key part read out of **another fold**, as it stood when the record being
// folded was appended. `@seat.booked` carries no title, and before this it would have had
// to, purely so revenue could be grouped by one. The lookup is written exactly as a
// command reads a fold, and it makes this fold query-only for the sharpest version of the
// reason above: its boundary is another key's whole history.
fold WorkshopTitle(workshop_id: Uuid) -> String = "untitled" {
  on @workshop.opened(workshop_id) { title } => title
}

// Strictly before the record, so a seat booked before the workshop was opened counts
// under `"untitled"` rather than under a title it did not have yet. `hek check --tables`
// prints `(keyed through workshop_title)` against this column, which is how a reader sees
// why editing `WorkshopTitle` refolds this one.
fold TitleRevenue(title: String) -> taken: Money(2) = 0 {
  on @seat.booked() { workshop_id, paid } key title = WorkshopTitle { workshop_id } =>
    taken + paid
}
