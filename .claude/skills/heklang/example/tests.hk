// A test is a declaration, so a file of them is an ordinary module. It states a log,
// one thing to do to it, and what should come out.

const RUST: Uuid = "0190d1a1-0000-7000-8000-000000000001"
const BOOKING: Uuid = "0190d1a1-0000-7000-8000-000000000002"
const SECOND: Uuid = "0190d1a1-0000-7000-8000-000000000003"

// The event the harness stamps at position 1, which is what `e.id` reads in the arm.
const TRIGGER: Uuid = "0190d1a1-0000-7000-9000-000000000001"

fn seats_for(n: Int) -> Int {
  return n * 2
}

// The same device one level up: a `fn` may return an event, so the seat every case
// below needs is written once. A `given` and an `expect` take the call, with the fields
// that case is about written after it.
fn a_seat(booking_id: Uuid, attendee_id: Attendee) -> @seat.booked {
  return @seat.booked {
    workshop_id: RUST,
    booking_id,
    attendee_id,
    email: "ada@example.com",
    paid: 40.00,
  }
}

test "a seat in an open workshop with room is booked as written" {
  given @workshop.opened {
    workshop_id: RUST,
    title: "Rust",
    seats: seats_for(1),
    price: 40.00,
  }

  run BookSeat {
    workshop_id: RUST,
    booking_id: BOOKING,
    attendee_id: 7,
    email: "ada@example.com",
    paid: 40.00,
  }

  expect @seat.booked {
    workshop_id: RUST,
    booking_id: BOOKING,
    attendee_id: 7,
    email: "ada@example.com",
    paid: 40.00,
  }
}

test "a workshop nobody opened is refused before anything else is read" {
  run BookSeat {
    workshop_id: RUST,
    booking_id: BOOKING,
    attendee_id: 7,
    email: "ada@example.com",
    paid: 40.00,
  }

  expect reject WorkshopIsClosed
}

test "a blank email is the caller's mistake, whatever the log says" {
  run BookSeat {
    workshop_id: RUST,
    booking_id: BOOKING,
    attendee_id: 7,
    email: "   ",
    paid: 40.00,
  }

  expect invalid "an attendee needs an email"
}

test "the last seat is the last seat" {
  given @workshop.opened { workshop_id: RUST, title: "Rust", seats: 1, price: 40.00 }
  given a_seat(BOOKING, 7)

  run BookSeat {
    workshop_id: RUST,
    booking_id: SECOND,
    attendee_id: 9,
    email: "grace@example.com",
    paid: 40.00,
  }

  expect reject WorkshopIsFull { seats: 1 }
}

test "releasing a seat nobody holds appends nothing" {
  given @workshop.opened { workshop_id: RUST, title: "Rust", seats: 2, price: 40.00 }

  run ReleaseSeat { workshop_id: RUST, booking_id: BOOKING, attendee_id: 7 }

  expect nothing
}

test "a booking writes its row and counts against the workshop" {
  given @workshop.opened { workshop_id: RUST, title: "Rust", seats: 2, price: 40.00 }
  given a_seat(BOOKING, 7)

  project Workshops

  // A row is matched on the columns the test lists; an event is matched on all of them.
  expect Workshop[RUST] { seats: 2, taken: 1, revenue: 40.00, status: Open }
  expect Booking[BOOKING] { attendee_id: 7, email: "ada@example.com", confirmed_at: none }
}

test "a booking for a workshop that is gone drops rather than manufacturing one" {
  given a_seat(BOOKING, 7)

  project Workshops

  expect no Workshop[RUST]
  expect Booking[BOOKING] { attendee_id: 7 }
}

test "a first booking is confirmed, logged and recorded" {
  given @workshop.opened { workshop_id: RUST, title: "Rust", seats: 2, price: 40.00 }
  given a_seat(BOOKING, 7)

  respond CONFIRM_URL 200

  deliver ConfirmBooking

  // A body is matched on the keys the test writes; an `invoke`'s arguments are matched
  // exactly, because a command's arguments are its whole input.
  expect http.post(CONFIRM_URL, { "to": "ada@example.com", "first_booking": true })
  expect log("confirmed booking {BOOKING} for attendee 7")
  expect invoke RecordConfirmed {
    booking_id: BOOKING,
    notification_id: Uuid.derive(TRIGGER, "confirmation"),
  }
}

test "a retryable status is absorbed by the runtime and never reaches the arm" {
  given @workshop.opened { workshop_id: RUST, title: "Rust", seats: 2, price: 40.00 }
  given a_seat(BOOKING, 7)

  respond CONFIRM_URL 503
  respond CONFIRM_URL 200

  deliver ConfirmBooking

  expect http.post(CONFIRM_URL)
  expect log("confirmed booking {BOOKING} for attendee 7")
  expect invoke RecordConfirmed {
    booking_id: BOOKING,
    notification_id: Uuid.derive(TRIGGER, "confirmation"),
  }
}

test "a 4xx is a decision the arm makes, and it fails terminally" {
  given @workshop.opened { workshop_id: RUST, title: "Rust", seats: 2, price: 40.00 }
  given a_seat(BOOKING, 7)

  respond CONFIRM_URL 422

  deliver ConfirmBooking

  expect http.post(CONFIRM_URL)
  expect fail "confirmation rejected with status 422"
}

test "an erased attendee skips rather than sending plaintext" {
  given @workshop.opened { workshop_id: RUST, title: "Rust", seats: 2, price: 40.00 }
  given a_seat(BOOKING, 7)

  erased Attendee "7"

  deliver ConfirmBooking

  expect skipped
}

// The two ways a named fold is asserted. `fold` names one column at one key and takes
// exactly one `expect`; `fill` follows the whole given log into the derived read model
// and asserts a row of it, which is what a projector's row expectation was before the
// read side became folds.
test "releasing a seat gives it back" {
  given @workshop.opened { workshop_id: RUST, title: "Rust", seats: 2, price: 40.00 }
  given a_seat(BOOKING, 7)
  given @seat.released { workshop_id: RUST, booking_id: BOOKING, attendee_id: 7 }

  fold WorkshopSeatsLeft { workshop_id: RUST }

  expect 2
}

test "a booked seat fills the row it is keyed by" {
  given @workshop.opened { workshop_id: RUST, title: "Rust", seats: 2, price: 40.00 }
  given a_seat(BOOKING, 7)

  fill

  // The column names are `hek check --tables`', and the subscript is the whole key in
  // the order that listing prints: the subject part leads.
  expect attendee__workshop[7, RUST] {
    attendee_seats: 1,
    // Sealed on the event and sealed in the column, and compared on its plaintext: the
    // runner opens it through the world's key store, so a test writes what it put in.
    attendee_email: "ada@example.com",
    // Query-only, readable here and by nothing that decides. The harness stamps one
    // minute per event from 2020-01-01T00:00:00Z, so this is the second `given`.
    attendee_booked_at: "2020-01-01T00:01:00Z",
  }
  expect no attendee__workshop[8, RUST]

  // A column no arm wrote is at its seed rather than missing, which is the one way a
  // derived row reads differently from a projector's.
  expect workshop[RUST] { workshop_seats_left: 1, workshop_revenue: 40.00 }
}

// The computed key part, read back by the bucket it computed. The harness stamps one
// minute per event from 2020-01-01, so both bookings land in `"2020-01"`.
test "a month's takings are bucketed by when the seat was booked" {
  given @workshop.opened { workshop_id: RUST, title: "Rust", seats: 4, price: 40.00 }
  given a_seat(BOOKING, 7)
  given a_seat(SECOND, 8)

  fold MonthlyRevenue { workshop_id: RUST, month: "2020-01" }

  expect 80.00
}

// Rule 15, through both drivers. The workshop is opened first, so the seat's lookup finds
// the title; `fill` reads what the sink wrote and `fold` scans and compares, and the two
// agreeing is the whole of that rule's correctness.
test "revenue is grouped by a title the booking event does not carry" {
  given @workshop.opened { workshop_id: RUST, title: "Rust", seats: 2, price: 40.00 }
  given a_seat(BOOKING, 7)

  fill

  expect title["Rust"] { title_revenue: 40.00 }
}

test "a seat booked before the workshop was opened reads the title it had then" {
  // Strictly before the record, so this one is counted under the seed: at the booking
  // there was no title yet. The second seat finds one.
  given a_seat(BOOKING, 7)
  given @workshop.opened { workshop_id: RUST, title: "Rust", seats: 2, price: 40.00 }
  given a_seat(SECOND, 8)

  fold TitleRevenue { title: "untitled" }

  expect 40.00
}
