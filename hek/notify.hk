// effects/notify.hk

// Rule 16: a deployment credential, not a `const`. The value differs between dev,
// staging and production and rotates out of band, so it is not part of the program:
// a `const` here would put the address in git and in the digest hash, and rotating it
// would cost replay coverage on every invocation already journaled against that hash.
secret CONFIRM_URL

effect NotifyCustomer {
  on live @order.placed as e { @key customer_id } {
    // Rule 3: folded up to and including this event, so a customer's first order
    // leaves the count at one rather than zero.
    fold orders: Int = 0
      on @order.placed(customer_id: e.customer_id) => orders + 1

    // The url may be the credential itself, which is what a webhook address is. It
    // reaches the wire spelled out and the journal key named, so a rotation lands on
    // the entry that already recorded the send.
    let response = http.post(
      CONFIRM_URL,
      { "to": reveal(e.email), "order_id": e.order_id, "first_order": orders == 1 },
    )

    // Every retryable status was absorbed by the runtime, so a 4xx here is a real
    // decision rather than something to re-implement.
    if response.status >= 400 {
      fail "confirmation rejected"
    }

    log("confirmed an order")

    invoke RecordNotified {
      order_id: e.order_id,
      notification_id: Uuid.derive(e.id, "confirmation"),
    }
  }
}

refusal AlreadyNotified "this order was already confirmed"

// commands/internal/record_notified.hk
//
// Internal: an effect writes back to the log by calling a command, never by appending,
// so the fact lands under the command's own guard.

command RecordNotified(order_id: Uuid, notification_id: Uuid) {
  // No raw `guard @order.notified(order_id)` here: the fold below already declares that
  // slice, so writing it twice adds an identical predicate and no safety.
  fold notified: Bool = false
    on @order.notified(order_id) => true

  if notified {
    reject AlreadyNotified
  }

  emit @order.notified { order_id, notification_id, at: now() }
}

// events/notified.hk

event @order.notified {
  order_id: Uuid,
  notification_id: Uuid,
  at: Timestamp,
}
