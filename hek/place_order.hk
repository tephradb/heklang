// events/order.hk

event @order.placed {
  order_id: Uuid,
  customer_id: Int,
  email: String @subject(customer_id) @max(200),
  address: String @subject(customer_id) @max(200),
  total: Money(2),
  tax_rate: Decimal(4),
  notes: String @no_index,
}

event @order.cancelled {
  order_id: Uuid,
  customer_id: Int,
  refund: Money(2),
}

event @customer.blocked {
  customer_id: Int,
  reason: String,
}

// refusals/order.hk
//
// One home for each refusal this module can answer with, so no two sites can disagree
// about what one means. The code a caller sees is the name in snake_case, which is how
// `CustomerBlocked` reaches a client as "customer_blocked".

refusal CustomerBlocked "this customer cannot place orders"
refusal EmailTaken "that email has already placed an order"
refusal TooManyOpen "too many open orders"

// guards/order.hk
//
// Each of these is a proposition about the log with one refusal, named for what it
// asserts rather than for the entity it reads. The order they appear in the command is
// the order they refuse in.

guard CustomerIsNotBlocked(customer_id: Int) {
  // A leading `let` a filter names is hoisted here exactly as it is in a command: a
  // guard's prologue is a command's prologue.
  let customer = customer_id
  state blocked: Bool = fold false
    on @customer.blocked(customer_id: customer) => true

  if blocked {
    return reject CustomerBlocked
  }
}

guard EmailIsUnused(email: String) {
  state taken: Bool = fold false
    on @order.placed(email) => true

  if taken {
    return reject EmailTaken
  }
}

guard UnderOpenOrderLimit(customer_id: Int) {
  state open_orders: Int = fold 0
    on @order.placed(customer_id) => open_orders + 1
    on @order.cancelled(customer_id) => open_orders - 1

  if open_orders >= 10 {
    return reject TooManyOpen
  }
}

// commands/place_order.hk

command PlaceOrder(
  order_id: Uuid,
  customer_id: Int,
  email: String,
  address: String,
  total: Money(2),
  tax_rate: Decimal(4),
  notes: String?,
) {
  guard @order.placed(order_id), @order.cancelled(order_id)

  guard CustomerIsNotBlocked { customer_id }
  guard EmailIsUnused { email }
  guard UnderOpenOrderLimit { customer_id }

  // Folded here rather than guarded, because it decides a discount rather than a
  // refusal, and a guard hands nothing back.
  state lifetime_spend: Money(2) = fold 0
    on @order.placed(customer_id) { total } => lifetime_spend + total

  // Not a guard either: it is about the input rather than the log, so it folds nothing.
  if address.trim() == "" {
    return invalid("address must not be blank")
  }

  let discounted = if lifetime_spend > 1000.00 { total.mul(0.9, HalfUp) } else { total }

  emit @order.placed {
    order_id,
    customer_id,
    email,
    address,
    total: discounted,
    tax_rate,
    notes: notes.unwrap_or(""),
  }
}

command BareDiscount(total: Money(2)) {
  let cut = total * 0.9
  return
}
