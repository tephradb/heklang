// tests/orders.hk
//
// The three handler kinds, tested the way an application author would: a log written
// out as events, one thing done to it, and what should come out.

const ADA: Uuid = "0190d1a1-0000-7000-8000-000000000001"
const GRACE: Uuid = "0190d1a1-0000-7000-8000-000000000002"

// One address, written once. A `fn` is callable from a `given` and an `expect` as well
// as from a `run`, so the record does not have to be spelled out at each of the twenty
// positions a test names one.
fn address(n: Int) -> Address {
  return Address { line1: "{n} Reykjavik St", city: "Reykjavík", postcode: "101" }
}

// The same device one level up: a `fn` may return an event, so the whole of
// `@order.placed` is written once here and every `given` and `expect` below is a call
// and the fields that case is about. A `run` still writes its arguments out, because a
// command's arguments are its input rather than an event.
fn placed(
  order_id: Uuid,
  customer_id: Customer,
  email: String,
  total: Money(2),
) -> @order.placed {
  return @order.placed {
    order_id,
    customer_id,
    email,
    address: address(12),
    total,
    tax_rate: 0.2000,
    notes: "",
  }
}

test "a first order for a fresh customer is appended as written" {
  run PlaceOrder {
    order_id: ADA,
    customer_id: 1,
    email: "ada@example.com",
    address: address(12),
    total: 25.99,
    tax_rate: 0.2000,
    notes: "leave at the door",
  }

  expect placed(ADA, 1, "ada@example.com", 25.99) { notes: "leave at the door" }
}

test "an absent note becomes the empty string rather than staying absent" {
  run PlaceOrder {
    order_id: ADA,
    customer_id: 1,
    email: "ada@example.com",
    address: address(12),
    total: 25.99,
    tax_rate: 0.2000,
  }

  expect placed(ADA, 1, "ada@example.com", 25.99)
}

test "a blank address is the caller's mistake" {
  run PlaceOrder {
    order_id: ADA,
    customer_id: 1,
    email: "ada@example.com",
    address: Address { line1: "   ", city: "Reykjavík", postcode: "101" },
    total: 25.99,
    tax_rate: 0.2000,
  }

  expect invalid "address must not be blank"
}

test "an email that already placed an order is refused" {
  given placed(ADA, 1, "ada@example.com", 25.99)

  run PlaceOrder {
    order_id: GRACE,
    customer_id: 2,
    email: "ada@example.com",
    address: address(4),
    total: 10.00,
    tax_rate: 0.2000,
  }

  expect reject EmailTaken
}

test "a blocked customer is refused before anything else is checked" {
  given @customer.blocked { customer_id: 1, reason: "chargebacks" }

  run PlaceOrder {
    order_id: ADA,
    customer_id: 1,
    email: "ada@example.com",
    address: address(12),
    total: 25.99,
    tax_rate: 0.2000,
  }

  expect reject CustomerBlocked
}

test "a customer past a thousand gets a tenth off" {
  given placed(GRACE, 1, "first@example.com", 1500.00)

  run PlaceOrder {
    order_id: ADA,
    customer_id: 1,
    email: "ada@example.com",
    address: address(12),
    total: 100.00,
    tax_rate: 0.2000,
  }

  expect placed(ADA, 1, "ada@example.com", 90.00)
}

test "a placed order writes the row and counts the customer" {
  given placed(ADA, 1, "ada@example.com", 25.99)

  project Orders

  expect Order[ADA] { customer_id: 1, total: 25.99, status: Placed, tracking: none }
  expect CustomerTotals[1] { order_count: 1, lifetime_spend: 25.99, name: "unknown" }
}

test "a purged order does not come back on a late shipment" {
  given placed(ADA, 1, "ada@example.com", 25.99)
  given @order.purged { order_id: ADA }
  given @order.shipped { order_id: ADA, tracking: "TRK-1" }

  project Orders

  // It really does not come back, which it used to: a `patch` materialized the row from
  // its columns' zeros, and the zero of `customer_id` was customer 0. Now that a subject
  // id has no zero, `check_zeros` refuses that materialization, and `update` says what
  // the handler meant anyway: a shipment for an order nobody placed changes nothing.
  expect no Order[ADA]
}

test "confirming an order reveals the email and records the notification" {
  given placed(ADA, 1, "ada@example.com", 25.99)

  // The override, for when the value's shape matters. It sits beside the `respond` that
  // answers it, which is the reason it is a setup line rather than a `given`.
  secret CONFIRM_URL = "https://mail.example/confirm"
  respond "https://mail.example/confirm" 200

  deliver NotifyCustomer

  expect http.post(
    "https://mail.example/confirm",
    { "to": "ada@example.com", "first_order": true },
  )
  expect log("confirmed an order")
  expect invoke RecordNotified {
    order_id: ADA,
    notification_id: Uuid.derive("0190d1a1-0000-7000-9000-000000000000", "confirmation"),
  }
}

test "an absorbed retry never reaches the arm" {
  given placed(ADA, 1, "ada@example.com", 25.99)

  // No setup line: a declared secret answers `secret:NAME`, so a test that does not
  // care about the value names the stand-in and moves on.
  respond "secret:CONFIRM_URL" 503
  respond "secret:CONFIRM_URL" 200

  deliver NotifyCustomer

  expect http.post("secret:CONFIRM_URL")
  expect log("confirmed an order")
  expect invoke RecordNotified {
    order_id: ADA,
    notification_id: Uuid.derive("0190d1a1-0000-7000-9000-000000000000", "confirmation"),
  }
}

test "a 4xx is a decision the arm makes, and it fails terminally" {
  given placed(ADA, 1, "ada@example.com", 25.99)

  respond "secret:CONFIRM_URL" 422

  deliver NotifyCustomer

  expect http.post("secret:CONFIRM_URL")
  expect fail "confirmation rejected"
}

test "an erased customer skips rather than sending plaintext" {
  given placed(ADA, 1, "ada@example.com", 25.99)

  erased Customer "1"

  deliver NotifyCustomer

  expect skipped
}

// A note longer than the column is the case the `@max` invariant cannot see, because an
// interpolation has no declaration to compare against. Without the `truncate` in
// `Notes` this is a hard error rather than a row.
test "a note past the column is kept to its first eight characters" {
  given placed(ADA, 1, "ada@example.com", 25.99) { notes: "leave at the door" }

  project Notes

  expect OrderNote[ADA] { note: "note: le" }
}
