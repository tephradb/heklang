// catalog/catalog.hk
//
// A fourth module, and a tour of what the port's first tranche added. Everything here
// is declared at module scope and used from a command, a projector and an effect, which
// is the point: before this pass an enum could not reach an event, a helper could not be
// spelled once, and there was no way to hold more than one of anything.

enum Tier { @default Free, Paid }

record Item {
  sku: String,
  price: Money(2),
  tags: List(String),
}

const HOUSE_TAG: String = "house"
const FREE_LIMIT: Int = 2

// The prefix a derived sku is built from, named once so the rule that rejects it and the
// rule that produces it cannot drift apart.
const RESERVED: String = "CATALOG:"

// A refusal names its fields, and its message may name those and nothing else, so what
// it says is settled here rather than at each site that answers with it.
refusal SkuTaken(sku: String, item: Uuid) "sku {sku} already belongs to item {item}"
refusal FreeLimit(limit: Int) "the free tier lists {limit} items"

// A const may name another const, above it, below it or in another file. What lands at
// the use site is still a literal, so this is not a runtime lookup.
const HOUSE_ITEM: Item = Item { sku: HOUSE_TAG, price: 0.00, tags: [HOUSE_TAG] }

// An optional const, which had no writable value at all before this pass: neither
// `none` nor a present one, which is why no record with an optional field could be a
// const either. A bare String fills the String? the way it does everywhere else.
const NO_SKU: String? = none
const FALLBACK_SKU: String? = HOUSE_TAG

// The RFC 4122 DNS namespace, as a stable arbitrary constant. Unspellable before a
// string literal could resolve against a `Uuid` target.
const NAMESPACE: Uuid = "6ba7b810-9dad-11d1-80b4-00c04fd430c8"

// lib/catalog.hk
//
// The helper that overturned "no user-defined functions": one rule about SKUs, needed
// by a command, a projector and an effect, and wrong the moment it is copied.
fn effective_sku(sku: String?, item_id: Uuid) -> String {
  let given = sku.unwrap_or("").trim()
  if given.is_empty() {
    return "{RESERVED}{item_id}"
  }
  return given
}

// A `fn` returning `Outcome?` decides a refusal on the command's behalf, and `none` is
// "no objection". Nothing here reads the log, which is why the command can ask it above
// its first fold.
fn sku_error(sku: String?) -> Outcome? {
  if sku.unwrap_or("").trim().starts_with(RESERVED) {
    return invalid("a sku may not start with {RESERVED}")
  }
  return none
}

fn tagged(items: Map(Uuid, Item), tag: String) -> List(String) {
  return [item.sku for item_id, item in items if item.tags.contains(tag)]
}

fn audit_id(seller_id: Int, at: Int) -> Uuid {
  return Uuid.derive(NAMESPACE, "{seller_id}/{at}")
}

// A `Response` is the one type only a `fn` may name. Reading one is pure, so a helper
// may take one; storing one is not, so no event, column or record may.
fn audit_note(response: Response) -> String {
  if response.status >= 400 {
    return "rejected ({response.status})"
  }
  return "accepted"
}

// events/catalog.hk

event @item.listed {
  item_id: Uuid,
  seller_id: Int,
  item: Item @no_index,
  tier: Tier,
}

event @item.delisted {
  item_id: Uuid,
  seller_id: Int,
}

event @item.flagged {
  item_id: Uuid,
  seller_id: Int,
  reason: String @max(60),
}

// commands/list_item.hk

command ListItem(
  item_id: Uuid,
  seller_id: Int,
  sku: String?,
  price: Money(2),
  tags: List(String),
  tier: Tier,
) {
  // Decided from the request alone, so it is written above the declarations and answers
  // without reading anything. A caller who sends the derived prefix gets `invalid` here
  // rather than a refusal about whichever item happens to hold that sku, which is what
  // it got when this check sat below the fold.
  let objection = sku_error(sku)
  if objection.is_some() {
    return objection
  }

  // The seller's live catalogue, keyed by item. Uniqueness is a rule about all of it,
  // so the boundary is every listing this seller has.
  fold items: Map(Uuid, Item) = Map.empty
    on @item.listed(seller_id) { item_id, item } => items.set(item_id, item)
    on @item.delisted(seller_id) { item_id } => items.remove(item_id)

  let wanted = effective_sku(sku, item_id)

  for other_id, other in items {
    if other_id != item_id && other.sku == wanted {
      return reject SkuTaken { sku: wanted, item: other_id }
    }
  }

  if tier == Free && items.len() >= FREE_LIMIT {
    return reject FreeLimit { limit: FREE_LIMIT }
  }

  emit @item.listed { item_id, seller_id, item: Item { sku: wanted, price, tags }, tier }
}

// projectors/catalog.hk

projector Catalog {
  entity Listing {
    item_id: Uuid @key,
    seller_id: Int @index,
    sku: String @max(60),
    price: Money(2),
    // The same enum as on the event, so a variant that is not in the set cannot reach
    // the column at all.
    tier: Tier,
    tags: List(String),
    flags: Int,
  }

  on @item.listed { item_id, seller_id, item, tier } {
    put Listing {
      item_id,
      seller_id,
      sku: item.sku,
      price: item.price,
      tier,
      tags: item.tags,
      flags: 0,
    }
  }

  on @item.flagged { item_id } {
    patch Listing[item_id] { flags: .flags + 1 }
  }

  on @item.delisted { item_id } {
    delete Listing[item_id]
  }
}

// effects/audit_catalog.hk

effect AuditCatalog {
  // Three event types onto one body. They share `item_id` and `seller_id` and nothing
  // else, and that is exactly what the binding may name: `reason` is on the flag alone
  // and `item` on the listing alone, so neither is reachable here.
  on @item.listed, @item.delisted, @item.flagged as e { item_id, seller_id } {
    fold listed: Int = 0
      on @item.listed(seller_id) => listed + 1
      on @item.delisted(seller_id) => listed - 1

    fold house: Map(Uuid, Item) = Map.empty
      on @item.listed(seller_id) { item_id, item } => house.set(item_id, item)
      on @item.delisted(seller_id) { item_id } => house.remove(item_id)

    let response = http.post(
      "https://audit.example/catalog",
      { "seller": seller_id, "listed": listed, "house": tagged(house, HOUSE_TAG) },
      // What stops a second audit across a replay, and the reason the journal key
      // leaves headers out.
      headers = { "Idempotency-Key": "{audit_id(seller_id, e.position)}" },
    )

    log("audit {audit_note(response)} for seller {seller_id}")

    // A string literal inside the braces of another string literal. Before the lexer
    // nested, this needed a helper whose only job was to move the `""` out.
    if response.status >= 400 {
      fail("audit rejected: {response.body.string("error").unwrap_or("no reason")}")
    }

    log("seller {seller_id} now lists {listed}, house: {tagged(house, HOUSE_TAG)}")
  }
}

// tests/catalog.hk

// The defect that put the declarations after the statements. `CATALOG:` is the prefix a
// derived sku is built from, so before `sku_error` ran above the fold, a caller pasting
// `CATALOG:{some_uuid}` learned whether an item with that id existed: `sku_taken` when it
// did and `ok` when it did not, from a value the validator exists to reject. The world
// here would refuse too, which is the half no `expect invalid` test used to cover.
test "a reserved-prefix sku is the caller's mistake, not an answer from the log" {
  given @item.listed {
    item_id: "0190d1a1-0000-7000-8000-000000000031",
    seller_id: 1,
    item: Item {
      sku: "CATALOG:0190d1a1-0000-7000-8000-000000000031",
      price: 5.00,
      tags: [],
    },
    tier: Free,
  }

  run ListItem {
    item_id: "0190d1a1-0000-7000-8000-000000000032",
    seller_id: 1,
    sku: "CATALOG:0190d1a1-0000-7000-8000-000000000031",
    price: 9.99,
    tags: [],
    tier: Free,
  }

  expect invalid("a sku may not start with CATALOG:")
}
