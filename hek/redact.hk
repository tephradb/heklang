// A mandatory redaction, and the two shapes of `erase` side by side. One subject id is
// on the event being handled; the rest have to be found by folding the log, which is
// what a "delete everything you hold for this tenant" request always needs.

// events/tenant.hk

event @tenant.connected {
  tenant_id: Int,
  api_key: String @subject(tenant_id) @no_index @max(4096),
}

event @tenant.member.joined {
  tenant_id: Int,
  member_id: Int,
  email: String @subject(member_id) @max(200),
}

event @tenant.member.left {
  tenant_id: Int,
  member_id: Int,
}

event @tenant.redact.requested {
  tenant_id: Int,
}

// effects/redact_tenant.hk

effect RedactTenant {
  on @tenant.redact.requested as e { tenant_id } {
    // Every member the tenant still holds data for. A cursor would page this; a fold
    // does not, and a redact is rare and one-shot, so the width is acceptable here in
    // a way it would not be on a hot path.
    fold members: List(Int) = []
      on @tenant.member.joined(tenant_id) { member_id } =>
        if members.contains(member_id) { members } else { members.push(member_id) }
      on @tenant.member.left(tenant_id) { member_id } => members.remove(member_id)

    // The ids come from a fold of plaintext tags, so there is no field name for the
    // parser to recover and the subject is named instead. What it gives up is the
    // check that this Int really is a `member_id`; what it buys is the only shape a
    // bulk erase has.
    for id in members {
      erase(member_id, id)
    }

    // The tenant's own key is on the trigger, so this one infers. Both forms in one
    // arm is the point: reach for the inferring one wherever it reaches.
    erase(tenant_id)

    log("redacted {members.len()} members and the tenant key")
  }
}
